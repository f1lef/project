<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Squad404.Pages.LoginPage"
    BackgroundColor="#F8FAFF">

    <ScrollView>

        <VerticalStackLayout
            WidthRequest="390"
            Padding="24,48,24,30"
            Spacing="0"
            HorizontalOptions="Center">

            <!-- LOGO -->
            <HorizontalStackLayout
                Spacing="12"
                VerticalOptions="Center">

                <Grid
                    WidthRequest="40"
                    HeightRequest="40"
                    BackgroundColor="#315EF4">

                    <Label
                        Text="▦"
                        FontSize="25"
                        TextColor="White"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                </Grid>

                <Label
                    Text="Squad404"
                    FontSize="19"
                    FontAttributes="Bold"
                    TextColor="#17233C"
                    VerticalOptions="Center" />

            </HorizontalStackLayout>


            <!-- TITLE -->
            <Label
                Text="Вхід у застосунок"
                Margin="0,70,0,0"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#17233C" />

            <Label
                Text="Увійдіть, щоб переглядати свій розклад."
                Margin="0,8,0,0"
                FontSize="14"
                TextColor="#697891" />


            <!-- EMAIL -->
            <Label
                Text="Електронна пошта"
                Margin="0,65,0,8"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#25314A" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Введіть електронну пошту"
                PlaceholderColor="#9AA5B6"
                TextColor="#25314A"
                BackgroundColor="White"
                HeightRequest="56"
                FontSize="15" />


            <!-- PASSWORD -->
            <Label
                Text="Пароль"
                Margin="0,28,0,8"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#25314A" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Введіть пароль"
                PlaceholderColor="#9AA5B6"
                TextColor="#25314A"
                BackgroundColor="White"
                HeightRequest="56"
                FontSize="15"
                IsPassword="True" />


            <!-- BUTTON -->
            <Button
                Text="Увійти"
                Margin="0,70,0,0"
                HeightRequest="56"
                CornerRadius="12"
                BackgroundColor="#315EF4"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>