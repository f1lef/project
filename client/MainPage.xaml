<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Squad404.Client.MainPage"
    BackgroundColor="#F8FAFF"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,60,24,40"
            MaximumWidthRequest="440"
            HorizontalOptions="Fill"
            Spacing="0">

            <Label
                Text="Squad404"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#315EF4" />

            <Label
                Text="Вхід у застосунок"
                Margin="0,60,0,0"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#17233C" />

            <Label
                Text="Увійдіть, щоб переглядати свій розклад."
                Margin="0,12,0,0"
                FontSize="14"
                TextColor="#697891" />

            <Label
                Text="Електронна пошта"
                Margin="0,64,0,12"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#25314A" />

            <Border
                Stroke="#D7DFEC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Padding="14,0"
                HeightRequest="56">

                <Entry
                    x:Name="EmailEntry"
                    Placeholder="Введіть електронну пошту"
                    Keyboard="Email"
                    IsTextPredictionEnabled="False"
                    FontSize="15"
                    TextColor="#25314A"
                    PlaceholderColor="#758197"
                    BackgroundColor="Transparent" />
            </Border>

            <Label
                Text="Пароль"
                Margin="0,48,0,12"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#25314A" />

            <Border
                Stroke="#D7DFEC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="White"
                Padding="14,0"
                HeightRequest="56">

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Введіть пароль"
                    IsPassword="True"
                    FontSize="15"
                    TextColor="#25314A"
                    PlaceholderColor="#758197"
                    BackgroundColor="Transparent" />
            </Border>

            <Button
                Text="Увійти"
                Margin="0,100,0,0"
                HeightRequest="56"
                CornerRadius="12"
                BackgroundColor="#315EF4"
                TextColor="White"
                FontSize="16"
                FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>